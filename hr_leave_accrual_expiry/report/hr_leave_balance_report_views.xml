<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Wizard -->
    <record id="view_hr_leave_balance_report_wizard" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.wizard.form</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <form string="Leave Summary" class="custom_wizard_small">
                <group>
                    <group>
                        <field name="department_ids"
                               widget="many2many_tags"
                               placeholder="Departments..."
                               options="{'no_create': True}"/>
                        <field name="employee_ids"
                               widget="many2many_tags"
                               placeholder="Employees..."
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="as_of_date"/>
                    </group>
                </group>

                <div class="text-muted mt-2 mb-2">
                    Leave Departments and Employees empty to include all employees.
                    The report shows balances and expiry information as of the selected date.
                </div>

                <footer>
                    <button string="Generate"
                            type="object"
                            name="action_generate_and_view"
                            class="btn-primary oe_highlight"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Generated report list -->
    <record id="view_hr_leave_balance_report_list" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.list</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <list string="Leave Summary"
                  create="false"
                  edit="false"
                  delete="false"
                  default_order="employee_id, leave_type_id">
                <field name="employee_id" width="180px"/>
                <field name="department_id" width="160px"/>
                <field name="leave_type_id" width="160px"/>
                <field name="remaining_balance" width="110px"/>
                <field name="leaves_taken" width="90px"/>
                <field name="total_expired" width="100px"/>
                <field name="closest_remaining" width="120px"/>
                <field name="next_expire_date" width="140px" class="date_col"/>
                <field name="total_allocated_days" optional="hide" width="130px"/>
            </list>
        </field>
    </record>

    <!-- Search and grouping -->
    <record id="view_hr_leave_balance_report_search" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.search</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <search string="Leave Summary">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="leave_type_id"/>

                <separator/>

                <filter name="has_expired"
                        string="Has expired balance"
                        domain="[('total_expired', '&gt;', 0)]"/>
                <filter name="has_remaining"
                        string="Has remaining balance"
                        domain="[('remaining_balance', '&gt;', 0)]"/>
                <filter name="expiring_soon"
                        string="Expiring soon"
                        domain="[('closest_remaining', '&gt;', 0), ('next_expire_date', '!=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_employee"
                            string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department"
                            string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_leave_type"
                            string="Time Off Type"
                            context="{'group_by': 'leave_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Wizard action -->
    <record id="action_hr_leave_balance_report_wizard" model="ir.actions.act_window">
        <field name="name">Leave Summary</field>
        <field name="res_model">hr.leave.balance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_hr_leave_balance_report_wizard"/>
    </record>

    <menuitem
        id="menu_hr_leave_balance_report"
        name="Leave Summary"
        parent="hr_holidays.menu_hr_holidays_report"
        action="action_hr_leave_balance_report_wizard"
        sequence="30"
    />

</odoo>
